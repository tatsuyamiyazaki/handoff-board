rules_version = '2';

// クライアントからの Firestore 直アクセスは全面拒否する。
// HANDOFF のデータアクセスはすべて api（Firebase Admin SDK）経由で行うため、
// Admin SDK はこのルールをバイパスする。クライアント SDK 経由の読み書きは禁止。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
