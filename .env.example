# 機械系クライアント用トークン → actor 種別 のJSONマップ
# 例: {"dispatcher-token":"ai-batch","agent-token":"ai-interactive"}
BOARD_TOKENS={"dev-board-token":"ai-batch"}

# 人間ログインの許可メール（カンマ区切り、#02で使用）
ALLOWED_EMAILS=tatsuya.miyazaki@gmail.com

# Web(Vite) からの fetch を通す CORS 許可オリジン（カンマ区切り）。
# 未設定なら http://localhost:5173 と http://127.0.0.1:5173 を既定で許可。
# CORS_ORIGIN=http://localhost:5173

# ローカル開発時の Firestore エミュレータ接続先（Java/firebase CLI 導入後に有効化）
# FIRESTORE_EMULATOR_HOST=localhost:8080
GCLOUD_PROJECT=handoff-local

# APIポート
PORT=8787
