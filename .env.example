# 機械系クライアント用トークン → actor（owner または owner:機能）のJSONマップ（ADR-0008）。
# AI 実行者×機能ごとにトークンを分け、activity の actor / created_by に実行主体を残す。
# Cloud Run Secret の運用値更新は docs/DEPLOYMENT.md に従う別作業。
BOARD_TOKENS={"cc-dev-token":"claude-code:dev","cc-reviewer-token":"claude-code:reviewer","cc-ceo-token":"claude-code:ceo","cowork-token":"cowork"}

# 人間ログインの許可メール（カンマ区切り、#02で使用。email 完全一致）
ALLOWED_EMAILS=t_miyazaki@sunbit.co.jp

# 人間ログインの許可メールドメイン（カンマ区切り、@以降のドメイン一致で許可）。
# 社内アカウント全体を通したい場合に使う。ALLOWED_EMAILS と併用可（どちらか一致で許可）。
# ALLOWED_EMAIL_DOMAINS=sunbit.co.jp

# Web(Vite) からの fetch を通す CORS 許可オリジン（カンマ区切り）。
# 未設定なら http://localhost:5173 と http://127.0.0.1:5173 を既定で許可。
# CORS_ORIGIN=http://localhost:5173

# ローカル開発時の Firestore エミュレータ接続先（Java/firebase CLI 導入後に有効化）
# FIRESTORE_EMULATOR_HOST=localhost:8080
GCLOUD_PROJECT=handoff-local

# APIポート
PORT=8787
