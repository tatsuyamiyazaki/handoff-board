{
  "name": "@handoff/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
