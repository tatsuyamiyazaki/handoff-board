    "@handoff/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "electron": "^36.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "electron-builder": "^26.0.0"
  }
}
