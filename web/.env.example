# Web 用環境変数。Firebase プロジェクト作成後に各値を設定する（HITL セットアップ / ADR-0001）。
# 未設定の場合、人間サインインは無効化され、api-client は開発用 X-Board-Token にフォールバックする。
VITE_API_BASE=http://localhost:8787
VITE_BOARD_TOKEN=dev-board-token

# Firebase Web アプリ設定（コンソールの「アプリを追加 > Web」で取得）。シークレットではないがプロジェクト固有値。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
